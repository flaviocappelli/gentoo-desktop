# ShellCheck (-s bash -o all): PASS (2026-11-04)

set -euo pipefail

if command -v zarcsummary &> /dev/null; then
    # OpenZFS >= 2.4, see
    # https://github.com/openzfs/zfs/releases/tag/zfs-2.4.0
    CMD1=zarcsummary
    CMD2=zarcstat
elif command -v arc_summary &> /dev/null; then
    # OpenZFS < 2.4
    CMD1=arc_summary
    CMD2=arcstat
else
    printf '\nSorry, ZFS tools not installed\n\n'
    exit 1
fi

printf '\n'
if ! "${CMD1}" -s arc | grep -A 6 'ARC status:'; then
    printf 'Retrieval of ARC status failed\n'
    exit 1
fi
printf '\nARC statistics:\n'
if ! "${CMD2}"; then
    printf 'Retrieval of ARC statistics failed\n'
    exit 1
fi
printf '\n'
exit 0
